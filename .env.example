# 이 파일을 .env.local로 복사한 뒤 발급받은 키를 입력하세요.
# 실행: npm run dev (http://localhost:3000)
# 키 변경 후에는 개발 서버를 다시 시작하세요.
# .dev.vars 파일이 있으면 .env.local보다 우선하므로 한 방식만 사용하세요.

# ANU Quantum Numbers API 키
# 발급: https://quantumnumbers.anu.edu.au/
# 비워 두면 ANU를 건너뛰고 Random.org를 사용합니다.
ANU_API_KEY=

# Random.org API 키 (선택)
# 발급: https://api.random.org/api-keys
# 입력하면 JSON-RPC API, 비워 두면 기존 공개 HTTP API를 사용합니다.
RANDOM_ORG_API_KEY=

# Random.org 해시된 키 (선택, 기존 설정 호환용)
# 현재 난수 생성 요청의 인증에는 사용하지 않습니다.
RANDOM_ORG_HASHED_API_KEY=

# SEED_POOL은 wrangler.jsonc의 KV 바인딩으로 설정됩니다.
# 로컬에서는 자동으로 별도 저장소를 사용하므로 Cloudflare 키가 필요 없습니다.
# 생성할 때마다 새 난수를 요청합니다. 키 변경 후 서버를 다시 시작하세요.
